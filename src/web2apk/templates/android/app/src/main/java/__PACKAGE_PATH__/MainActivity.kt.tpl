    // ---- JavaScript bridge --------------------------------------------------------------------
    //
    // Uses WebViewCompat.addWebMessageListener restricted to the app's own asset origin, NOT
    // addJavascriptInterface (which would be reachable from every frame, including remote iframes).
    // Protocol: JS sends a JSON string {"id":1,"method":"showToast","args":{"text":"hi"}} with
    // Web2ApkBridge.postMessage(...); native replies {"id":1,"ok":true,"result":...} to
    // Web2ApkBridge.onmessage / addEventListener("message", ...).

    private fun installBridge() {
        if (!AppConfig.JS_BRIDGE) return
        if (!WebViewFeature.isFeatureSupported(WebViewFeature.WEB_MESSAGE_LISTENER)) return
        val origins = setOf("https://${AppConfig.ASSET_HOST}")
        WebViewCompat.addWebMessageListener(webView, "Web2ApkBridge", origins) { _, message, _, isMainFrame, reply ->
            val raw = message.data
            if (!isMainFrame || raw == null || raw.length > 4096) return@addWebMessageListener
            val out = JSONObject()
            try {
                val req = JSONObject(raw)
                val id = req.opt("id")
                out.put("id", id)
                val args = req.optJSONObject("args") ?: JSONObject()
                when (req.optString("method")) {
                    "getAppInfo" -> {
                        val info = packageManager.getPackageInfo(packageName, 0)
                        out.put("ok", true).put(
                            "result",
                            JSONObject().put("name", AppConfig.APP_NAME).put("versionName", info.versionName)
                                .put("packageName", packageName)
                        )
                    }
                    "isOnline" -> out.put("ok", true).put("result", isOnline())
                    "showToast" -> {
                        val text = args.optString("text", "")
                        if (text.isEmpty() || text.length > 200) {
                            out.put("ok", false).put("error", "text must be 1-200 characters")
                        } else {
                            runOnUiThread { Toast.makeText(this, text, Toast.LENGTH_SHORT).show() }
                            out.put("ok", true).put("result", JSONObject.NULL)
                        }
                    }
                    else -> out.put("ok", false).put("error", "unknown method")
                }
            } catch (e: Exception) {
                out.put("ok", false).put("error", "bad request")
            }
            reply.postMessage(out.toString())
        }
